---
import Rule from './Rule.astro';

interface Props {
  active?: 'research' | 'writing' | 'projects' | 'about';
}

const { active } = Astro.props;

const links = [
  { href: '/research/', label: 'Research', key: 'research' },
  { href: '/writing/', label: 'Writing', key: 'writing' },
  { href: '/projects/', label: 'Projects', key: 'projects' },
  { href: '/about/', label: 'About', key: 'about' },
] as const;
---

<header class="frame">
  <div class="bar">
    <a class="wordmark" href="/">Alex Trubey</a>
    <nav aria-label="Primary">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[{ active: active === l.key }]}
          aria-current={active === l.key ? 'page' : undefined}
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
  <Rule variant="double" />
</header>

<style>
  .bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-block: var(--space-2) var(--space-1);
  }

  .wordmark {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: 0.01em;
  }

  nav {
    display: flex;
    gap: clamp(0.9rem, 2.5vw, 1.8rem);
    font-family: var(--sans);
    font-size: var(--size-kicker);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--track-caps);
  }

  nav a.active {
    color: var(--accent);
  }

  nav a.active::before {
    content: '\25c6\00a0'; /* small diamond marker */
    font-size: 0.7em;
  }
</style>
