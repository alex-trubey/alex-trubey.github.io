---
import Base from '../layouts/Base.astro';
import Rule from '../components/Rule.astro';
import Ornament from '../components/Ornament.astro';
import NetworkMotif from '../components/NetworkMotif.astro';
import PostList from '../components/PostList.astro';
import { getSubstackPosts } from '../lib/substack';

const posts = await getSubstackPosts(4);
---

<Base
  cover
  title="Alex Trubey"
  description="Economist studying how relationships shape economic life, in markets and on the ice. PhD student in economics at the University of Toronto."
>
  <div class="frame cover-frame">
    <p class="folio top">
      <span>Networks · Information · Sports</span>
      <span>Toronto · MMXXVI</span>
    </p>

    <h1 class="masthead-name">Alex Trubey</h1>

    <Rule variant="double" />
    <nav class="coverlines" aria-label="Primary">
      <a href="/research/">Research</a>
      <span aria-hidden="true">◆</span>
      <a href="/writing/">Writing</a>
      <span aria-hidden="true">◆</span>
      <a href="/projects/">Projects</a>
      <span aria-hidden="true">◆</span>
      <a href="/about/">About</a>
    </nav>
    <Rule variant="hairline" />

    <section class="stand">
      <p class="standfirst">
        I study how relationships shape <span class="nobr">economic life,</span> in markets and on
        the ice.
      </p>
      <NetworkMotif class="stand-motif" />
    </section>

    <section class="grid">
      <article class="lead">
        <div class="lead-inner">
          <p class="kicker">Working paper ◆ 2026</p>
          <h2>
            <a href="/research/#information-markets">
              Endogenous Network Formation in Information Markets
            </a>
          </h2>
          <p class="dek">
            Suppliers choose content quality and consumers choose whom to follow. Verification
            tools that raise quality on a fixed network can lower it once consumers rewire their
            links, tipping the market toward free-riding.
          </p>
          <a class="btn" href="/research/#information-markets">Read the abstract</a>
        </div>
      </article>

      <div class="rail">
        <article>
          <p class="kicker">Project</p>
          <h3><a href="https://alex-trubey.github.io/fabric-of-the-nhl/">The Fabric of the NHL</a></h3>
          <p class="railline">
            Roughly 2,400 players and 230,000 teammate ties in the modern NHL, on one interactive
            map.
          </p>
        </article>
        <Ornament class="rail-orn" />
        <article>
          <p class="kicker">Writing</p>
          <h3><a href="https://alextrubey.substack.com/p/heading-north">Heading North</a></h3>
          <p class="railline">Navigating PhD admissions, from one student's perspective.</p>
        </article>
      </div>
    </section>

    <section class="latest">
      <Rule variant="double" />
      <div class="latest-head">
        <h2 class="sc-head">Latest from No Fixed Position</h2>
        <a class="archive kicker" href="https://alextrubey.substack.com/archive">Full archive →</a>
      </div>
      <PostList posts={posts} />
    </section>
  </div>
</Base>

<style>
  /* The cover is a size container so the masthead can scale with the frame's
     inner width (cqw) and always sit on one line. */
  .cover-frame {
    container-type: inline-size;
  }

  .top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-block: 0.7rem;
    border-bottom: var(--rule-hairline) solid var(--line);
  }

  .masthead-name {
    font-family: var(--serif);
    font-weight: 800;
    font-size: var(--size-masthead); /* fallback for browsers without cqw */
    font-size: min(12.6cqw, 9.5rem);
    text-transform: uppercase;
    letter-spacing: 0.015em;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    padding-block: var(--space-3) var(--space-2);
  }

  .coverlines {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(0.8rem, 2.5vw, 1.6rem);
    padding-block: 0.75rem;
    font-family: var(--sans);
    font-size: var(--size-kicker);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--track-caps-wide);
  }

  .coverlines span {
    color: var(--accent);
    font-size: 0.55rem;
  }

  .stand {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-4);
    align-items: center;
    padding-block: var(--space-5);
  }

  .standfirst {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.3rem, 2.5vw, 1.85rem);
    line-height: 1.3;
    max-width: 40ch;
    text-wrap: balance;
  }

  .nobr {
    white-space: nowrap;
  }

  .stand :global(.stand-motif) {
    max-width: 330px;
    width: 100%;
    justify-self: end;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  /* Deco double frame: solid outer border, hairline inner echo. */
  .lead {
    position: relative;
    border: 1px solid var(--ink);
  }

  .lead::before {
    content: '';
    position: absolute;
    inset: 7px;
    border: var(--rule-hairline) solid var(--line);
    pointer-events: none;
  }

  .lead-inner {
    position: relative;
    padding: clamp(1.5rem, 3.5vw, 2.6rem);
  }

  .lead h2 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
    line-height: 1.08;
    margin-top: 0.5rem;
    max-width: 20ch;
  }

  .dek {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--size-dek);
    color: var(--ink-soft);
    margin-block: var(--space-2) var(--space-3);
    max-width: 44ch;
  }

  .rail article h3 {
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--size-h3);
    line-height: 1.15;
    margin-top: 0.4rem;
  }

  .railline {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-soft);
    font-size: 1rem;
    margin-top: 0.5rem;
  }

  .rail :global(.rail-orn) {
    margin-block: var(--space-3);
  }

  .latest {
    margin-top: var(--space-6);
  }

  .latest-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
    padding-block: var(--space-2) var(--space-1);
  }

  .archive:hover {
    color: var(--accent-deep);
  }

  @media (max-width: 860px) {
    .stand,
    .grid {
      grid-template-columns: 1fr;
    }

    .stand {
      padding-block: var(--space-4);
      gap: var(--space-3);
    }

    .stand :global(.stand-motif) {
      max-width: 250px;
      justify-self: start;
    }
  }
</style>
